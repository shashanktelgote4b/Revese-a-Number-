#include <stdio.h>
int main(void)
{
    int number;
    long long reverse = 0;
    printf("Enter a positive integer: ");
    scanf("%d", &number);
    if (number < 0)
    {
        printf("Please enter a non-negative integer.\n");
        return 1;
    }
    while (number != 0)
    {
        reverse = reverse * 10 + number % 10;
        number = number / 10;
    }
    printf("Reversed number = %lld\n", reverse);
    return 0;
}
